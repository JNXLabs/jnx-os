# =============================================================================
# JNX-OS ENVIRONMENT VARIABLES
# =============================================================================
# This file serves as a template for .env (production) and .env.local (development)
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env or .env.local to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# CLERK AUTHENTICATION
# -----------------------------------------------------------------------------
# Get your keys from: https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_secret_here

# Clerk Webhook Secret (for syncing user data)
# Get from: Clerk Dashboard > Webhooks > Add Endpoint
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Clerk Sign-in/Sign-up URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app

# -----------------------------------------------------------------------------
# SUPABASE DATABASE
# -----------------------------------------------------------------------------
# Get your credentials from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database Connection (for direct SQL queries if needed)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# GEMINI AI (for Qryx)
# -----------------------------------------------------------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
# Required for Qryx AI chat functionality
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# SHOPIFY APP (for Qryx)
# -----------------------------------------------------------------------------
# Get from: https://partners.shopify.com/ > Your App > App Setup
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here

# Shopify OAuth Scopes (comma-separated)
SHOPIFY_SCOPES=read_products,read_orders,write_script_tags,read_customers

# Shopify App URL (your deployed URL or ngrok for local development)
SHOPIFY_APP_URL=https://your-app.vercel.app

# Shopify Webhooks Secret (for verifying webhook authenticity)
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
# Base URL for the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment (development, staging, production)
NODE_ENV=development

# -----------------------------------------------------------------------------
# SECURITY (Production only)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# Session encryption key
SESSION_SECRET=your_session_secret_here

# -----------------------------------------------------------------------------
# MONITORING & LOGGING (Optional)
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking
# SENTRY_DSN=

# LogRocket ID for session replay
# LOGROCKET_ID=

# -----------------------------------------------------------------------------
# FEATURE FLAGS (Optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_LEARNING_PLATFORM=true
NEXT_PUBLIC_ENABLE_QRYX=true

# -----------------------------------------------------------------------------
# REDIS (Optional - for rate limiting in production)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# =============================================================================
# NOTES
# =============================================================================
# 1. Copy this file to .env.local for local development
# 2. Never commit .env.local to version control
# 3. Use Vercel/Platform environment variables for production
# 4. Restart your dev server after changing these values
# 5. All NEXT_PUBLIC_ variables are exposed to the browser
# =============================================================================
